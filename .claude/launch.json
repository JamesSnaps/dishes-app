{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dishes-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@dishes/web",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "dishes-web-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@dishes/web",
        "exec",
        "next",
        "start",
        "-p",
        "3001"
      ],
      "port": 3001
    },
    {
      "name": "dishes-web-next",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd apps/web && exec ./node_modules/.bin/next dev --turbopack"
      ],
      "port": 3000
    }
  ]
}
