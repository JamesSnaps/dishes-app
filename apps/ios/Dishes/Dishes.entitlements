<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Timer notifications break through Focus (the iPad's timers, which AlarmKit won't take). -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	<!-- Apple Push (Push.swift). Xcode switches this to "production" when exporting for TestFlight. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Sign-in tokens shared with the share extension (DishesShare, KeychainTokenStore.dishes). -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)uk.collco.dishes.shared</string>
	</array>
	<!-- The App Group: the database and the cached AI context, shared by the app, its widgets and the
	     share extension (AppGroup in DishesCore/Store/SharedStore.swift; TODO_MOBILE.md, Phase D0). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.uk.collco.dishes</string>
	</array>
</dict>
</plist>
